# API-only Novofon credentials.
#
# Copy to .api.secrets.env on the VPS, replace every placeholder, then:
#   chmod 600 .api.secrets.env
# This file is intentionally ignored by Git and mounted only into the `api`
# container. Do not put these values in .env, asterisk, worker, the browser,
# a mobile application, a support ticket, or a screenshot.
#
# Ask Novofon for a Call API token dedicated to CRM callbacks. If the provider
# cannot issue scopes/tokens separately, document that limitation and keep this
# value physically separate from the worker's Data API secret file.
NOVOFON_ACCESS_TOKEN=replace_with_call_api_token

# Generate two different values, each at least 32 random bytes. The first is
# embedded in the webhook URL; the second is sent by Novofon as integration_key.
NOVOFON_WEBHOOK_PATH_SECRET=replace_with_a_unique_32_byte_path_secret
NOVOFON_WEBHOOK_SECRET=replace_with_a_different_unique_32_byte_body_secret

# Отдельный секрет URL для интерактивного сценария входящего вызова.
# Никогда не переиспользуйте webhook-секреты выше.
NOVOFON_INTERACTIVE_PATH_SECRET=replace_with_a_third_unique_32_byte_path_secret
