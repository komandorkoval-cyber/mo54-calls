# ─────────────────────────────────────────────
# Сеть / VPS
# ─────────────────────────────────────────────
ASTERISK_PUBLIC_IP=1.2.3.4              # статический публичный IP VPS (curl ifconfig.me)

# ─────────────────────────────────────────────
# SIP-транк Новофон (IP-авторизация, без логина/пароля)
# ─────────────────────────────────────────────
SIP_SERVER=sip.novofon.ru               # адрес SIP-сервера (с экрана Новофона)
SIP_SERVER_IP=37.139.38.0/24            # официальная SIP-подсеть Novofon

# ─────────────────────────────────────────────
# Внутренний номер Игоря (softphone Linphone)
# ─────────────────────────────────────────────
IGOR_EXT_PASSWORD=changeme_strong_pass

# ─────────────────────────────────────────────
# PostgreSQL (CRM на VPS)
# ─────────────────────────────────────────────
POSTGRES_DB=calls_crm
POSTGRES_USER=calls_user
POSTGRES_PASSWORD=changeme_db_pass
DATABASE_URL=postgresql://calls_user:changeme_db_pass@postgres:5432/calls_crm

# ─────────────────────────────────────────────
# LLM
# LLM_PROVIDER=ollama     → локально (docker compose --profile local-llm up)
# LLM_PROVIDER=anthropic  → Claude Haiku через прокси/API
# ─────────────────────────────────────────────
# LLM_PROVIDER=gigachat  → GigaChat (Сбер), данные в РФ, рублёвая оплата (рекомендуется)
# LLM_PROVIDER=openai    → gpt-4o-mini через API
# LLM_PROVIDER=anthropic → Claude Haiku через API
# LLM_PROVIDER=ollama    → локально (VPS RAM < 2GB — нужна модель 1B)
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=base64_ключ_с_портала_developers.sber.ru
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS

OPENAI_API_KEY=sk-XXXX
OPENAI_MODEL=gpt-4o-mini

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b

ANTHROPIC_API_KEY=sk-ant-XXXX
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ─────────────────────────────────────────────
# Worker
# ─────────────────────────────────────────────
QUEUE_DIR=/queue
RECORDINGS_DIR=/recordings
POLL_INTERVAL=5

# CRM web/API (генерируйте уникальные значения перед первым запуском)
CRM_HTTP_PORT=8080
CRM_ADMIN_EMAIL=admin@example.local
CRM_ADMIN_PASSWORD=replace_with_a_unique_long_password
INGEST_TOKEN=replace_with_another_random_32_byte_value
SESSION_TTL_HOURS=12

# Публичный HTTPS-адрес CRM. В конфигурации сервера используется Punycode,
# хотя в браузере его можно открывать как https://calls.мягкиеокна54.рф.
# API по-прежнему слушает только 127.0.0.1:8080; наружу его публикует отдельный
# nginx virtual host из ops/nginx/. Не указывайте здесь IP-адрес или HTTP.
# Keep this empty for local HTTP development.  On VPS, set the exact HTTPS
# origin below only after the DNS A record and certificate are ready:
# PUBLIC_ORIGIN=https://calls.xn--54-6kclkrncnpj3r.xn--p1ai
PUBLIC_ORIGIN=
SESSION_COOKIE_NAME=mo54_calls_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict

# Ограничение попыток входа дополнительно к ограничению nginx. Формат и
# фактическое применение проверяются API; не ослабляйте значение в production.
CRM_LOGIN_MAX_ATTEMPTS=5
CRM_LOGIN_WINDOW_SECONDS=900

# ─────────────────────────────────────────────
# Интеграция Novofon: мобильный контур v1
# ─────────────────────────────────────────────
# Секреты Novofon не хранятся в .env. Создайте два отдельных файла по
# шаблонам .api.secrets.env.example и .worker.secrets.env.example, затем
# выполните chmod 600 для обоих. API получит только callback/webhook секреты,
# worker — только Data API token; Asterisk не получит ни один из них.
NOVOFON_WEBHOOK_ALLOWED_IPS=37.139.38.215

# Необязательный короткий сигнал сотруднику для входящего рабочего звонка.
# Аудиофайл остаётся в «Базе файлов» Novofon; CRM никогда его не получает.
NOVOFON_INTERACTIVE_ALLOWED_IPS=37.139.38.215
NOVOFON_INTERACTIVE_FORWARD_PHONE=
NOVOFON_INTERACTIVE_OPERATOR_MEDIA=

NOVOFON_CALL_API_URL=https://callapi-jsonrpc.novofon.ru/v4.0
NOVOFON_DATA_API_URL=https://dataapi-jsonrpc.novofon.ru/v2.0
NOVOFON_VIRTUAL_NUMBER=73832359277
NOVOFON_RECORDING_ALLOWED_HOSTS=novofon.ru
NOVOFON_ACCOUNT_TIMEZONE=Asia/Novosibirsk

# Сверка Data API восстанавливает пропущенные webhook за последние 24 часа.
# Не включайте до получения и проверки API-токена.
NOVOFON_RECONCILE_ENABLED=false
NOVOFON_RECONCILE_INTERVAL_SECONDS=3600

# В пилоте без оплаченной речевой аналитики выключено: CRM не должна запускать
# GigaChat и не должна придумывать транскрипт/выводы, если Novofon его не дал.
NOVOFON_TRANSCRIPT_ENABLED=false

# Путь к PEM bundle доверенного УЦ GigaChat внутри worker-контейнера.
# Worker-образ уже устанавливает официальные корневой и промежуточный
# сертификаты НУЦ Минцифры; по умолчанию используется системное хранилище.
# Не отключайте TLS-проверку. При необходимости можно указать корпоративный bundle:
# GIGACHAT_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Срок хранения аудио используется эксплуатационным cleanup-скриптом.
RECORDING_RETENTION_DAYS=180

# Bind Docker SIP/RTP ports. Keep 127.0.0.1 on a workstation.
# Use 0.0.0.0 on VPS only after applying the Novofon + VPN firewall rules.
ASTERISK_BIND_IP=127.0.0.1
